{
  "$schema": "https://opencode.ai/config.json",

  "instructions": [".opencode/rules/ds-rules.md"],

  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "webfetch": "deny",
    "task": "allow",
    "external_directory": {},
    "skill": { "*": "allow" },
    "edit": {
      "*": "ask",
      "pages/screens/genOD/*": "allow"
    },
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "sed -n *": "allow",
      "grep *": "allow",
      "find *": "allow",
      "wc *": "allow",
      "mkdir *": "allow",
      "cp *": "allow",
      "rm *": "deny",
      "git push*": "deny"
    }
  },

  "share": "disabled",
  "autoupdate": false
}
